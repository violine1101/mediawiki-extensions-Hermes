{
	"name": "Hermes",
	"author": [
		"violine1101"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:Hermes",
	"descriptionmsg": "hermes-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.45.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\Hermes\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\Hermes\\Tests\\": "tests/phpunit/integration/"
	},
	"config": {
		"HermesDebug": {
			"description": "Enable Hermes debug features.",
			"value": false
		},
		"HermesLanguageLinksInSidebar": {
			"description": "Add links to other-language versions of a page to the skin's \"In other languages\" box. Disable to show them some other way, e.g. from a skin using LanguageLink::forPage().",
			"value": true
		},
		"HermesWarnings": {
			"description": "Show on-page warning boxes for non-fatal issues resulting from the extension, such as Hermes tag ambiguities, conflicts, or duplicate {{#hermes:}} calls. When disabled, the relevant tracking categories are still applied, but no on-page warnings are shown.",
			"value": true
		}
	},
	"Hooks": {
		"LoadExtensionSchemaUpdates": "init",
		"UnitTestsAfterDatabaseSetup": "init",
		"BeforeInitialize": [ "init", "translationproject-page" ],
		"LinksUpdateComplete": "parserfunc",
		"PageDeleteComplete": "parserfunc",
		"ParserFirstCallInit": "parserfunc",
		"SidebarBeforeOutput": "languagelinks",
		"InternalParseBeforeLinks": "translationproject-link",
		"OutputPageRenderCategoryLink": "translationproject-category",
		"GetDefaultSortkey": "translationproject-category",
		"CategoryViewer::generateLink": "translationproject-category",
		"HtmlPageLinkRendererBegin": "translationproject-link",
		"HtmlPageLinkRendererEnd": "translationproject-link",
		"BeforeParserFetchTemplateRevisionRecord": "translationproject-template",
		"getUserPermissionsErrors": "translationproject-page",
		"PageContentLanguage": "translationproject-page",
		"UserGetLanguageObject": "translationproject-page",
		"ParserAfterParse": [ "parserfunc", "translationproject-page", "translationproject-template" ],
		"ParserAfterTidy": "translationproject-link",
		"OutputPageBeforeHTML": [ "translationproject-page", "translationproject-talk" ],
		"PageSaveComplete": "translationproject-talk",
		"EditFormPreloadText": "translationproject-translate",
		"SkinTemplateNavigation::Universal": "translationproject-translate",
		"WantedPages::getQueryInfo": "translationproject-wanted",
		"SpecialPage_initList": "translationproject-wanted"
	},
	"AvailableRights": [
		"hermes-add-translation-project"
	],
	"AuthManagerAutoConfig": {
		"preauth": {
			"MediaWiki\\Extension\\Hermes\\Auth\\ReservedUsernamePreAuthenticationProvider": {
				"class": "MediaWiki\\Extension\\Hermes\\Auth\\ReservedUsernamePreAuthenticationProvider"
			}
		}
	},
	"HookHandlers": {
		"init": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\InitHooks"
		},
		"parserfunc": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\ParserFuncHooks"
		},
		"languagelinks": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\LanguageLinkHooks",
			"services": [ "MainConfig", "LanguageNameUtils", "LanguageFactory" ]
		},
		"translationproject-page": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\PageHooks"
		},
		"translationproject-category": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\CategoryHooks"
		},
		"translationproject-link": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\LinkHooks"
		},
		"translationproject-talk": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\TalkPageHooks"
		},
		"translationproject-template": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\TemplateHooks"
		},
		"translationproject-wanted": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\WantedPagesHooks"
		},
		"translationproject-translate": {
			"class": "MediaWiki\\Extension\\Hermes\\Hooks\\TranslationProject\\TranslateHooks",
			"services": [ "RevisionLookup", "ContentHandlerFactory" ]
		}
	},
	"SpecialPages": {
		"HermesTags": {
			"class": "MediaWiki\\Extension\\Hermes\\Special\\SpecialHermesTags"
		},
		"HermesPages": {
			"class": "MediaWiki\\Extension\\Hermes\\Special\\SpecialHermesPages"
		},
		"HermesLanguages": {
			"class": "MediaWiki\\Extension\\Hermes\\Special\\SpecialHermesLanguages",
			"services": [ "LanguageNameUtils" ]
		},
		"HermesTranslate": {
			"class": "MediaWiki\\Extension\\Hermes\\Special\\SpecialHermesTranslate"
		}
	},
	"ExtensionMessagesFiles": {
		"HermesMagic": "Hermes.magic.php",
		"HermesAlias": "Hermes.alias.php"
	},
	"MessagesDirs": {
		"Hermes": [
			"i18n"
		]
	},
	"DatabaseVirtualDomains": [
		"virtual-hermes"
	],
	"TrackingCategories": [
		"hermes-duplicate-call-category",
		"hermes-tag-conflict-category",
		"hermes-ambiguous-links-category"
	],
	"ResourceModules": {
		"ext.hermes": {
			"localBasePath": "resources/ext.hermes",
			"remoteExtPath": "Hermes/resources/ext.hermes",
			"dependencies": [],
			"styles": [],
			"packageFiles": [
				"init.js"
			],
			"messages": []
		},
		"ext.hermes.special.styles": {
			"localBasePath": "resources/ext.hermes.special.styles",
			"remoteExtPath": "Hermes/resources/ext.hermes.special.styles",
			"styles": [ "special.less" ]
		}
	},
	"manifest_version": 2
}
